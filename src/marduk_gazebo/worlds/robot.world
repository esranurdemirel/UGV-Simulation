        </visual>
      </link>
    </model>

    <model name="dik_engel">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><mesh><uri>meshes/dik_engel.dae</uri></mesh></geometry>
        </collision>
        <visual name="visual">
          <geometry><mesh><uri>model://meshes/dik_engel.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name="sudan_gecis">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><mesh><uri>meshes/sudan_gecis.dae</uri></mesh></geometry>
        </collision>
        <visual name="visual">
          <geometry><mesh><uri>model://meshes/sudan_gecis.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name="yan_egim">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><mesh><uri>meshes/yan_egim.dae</uri></mesh></geometry>
        </collision>
        <visual name="visual">
          <geometry><mesh><uri>model://meshes/yan_egim.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

     <model name="engebeli_arazi">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><mesh><uri>meshes/engebeli_arazi.dae</uri></mesh></geometry>
        </collision>
        <visual name="visual">
          <geometry><mesh><uri>model://meshes/engebeli_arazi.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name="marduk_ika">
      <pose>4.2238 -0.4779 0.0369 0 0 0</pose> 
      <self_collide>false</self_collide>

       <link name="chassis">
        <pose>-0.5107 1.3734 0.7 0 0 0</pose>
        <inertial>
          <mass>0</mass>
          <inertia>
            <ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>/home/esranur-demirel/Desktop/simulation_1/meshes/sasi2.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>1.6 0.4 0.5</size></box>
          </geometry>
        </collision>
      </link>

      <link name="left_front_wheel">
        <pose>-1.15 0.55 0.35 1.5708 0 0</pose> 
        <inertial>
          <mass>25.0</mass>
          <inertia><ixx>1.5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5</iyy><iyz>0</iyz><izz>2.5</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>0.15</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>

      <link name="left_rear_wheel">
        <pose>0.45 0.55 0.35 1.5708 0 0</pose>
        <inertial>
          <mass>25.0</mass>
          <inertia><ixx>1.5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5</iyy><iyz>0</iyz><izz>2.5</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>0.15</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>

      <link name="right_front_wheel">
        <pose>-1.15 -0.64 0.35 1.5708 0 0</pose>
        <inertial>
          <mass>25.0</mass>
          <inertia><ixx>1.5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5</iyy><iyz>0</iyz><izz>2.5</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>0.15</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>

      <link name="right_rear_wheel">
        <pose>0.45 -0.64 0.35 1.5708 0 0</pose>
        <inertial>
          <mass>25.0</mass>
          <inertia><ixx>1.5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5</iyy><iyz>0</iyz><izz>2.5</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>0.15</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>

      <joint name="left_front_joint" type="revolute">
        <parent>chassis</parent><child>left_front_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1.79e+308</lower><upper>1.79e+308</upper></limit></axis>
      </joint>

      <joint name="left_rear_joint" type="revolute">
        <parent>chassis</parent><child>left_rear_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1.79e+308</lower><upper>1.79e+308</upper></limit></axis>
      </joint>

      <joint name="right_front_joint" type="revolute">
        <parent>chassis</parent><child>right_front_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1.79e+308</lower><upper>1.79e+308</upper></limit></axis>
      </joint>

      <joint name="right_rear_joint" type="revolute">
        <parent>chassis</parent><child>right_rear_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1.79e+308</lower><upper>1.79e+308</upper></limit></axis>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_front_joint</left_joint>
        <left_joint>left_rear_joint</left_joint>
        <right_joint>right_front_joint</right_joint>
        <right_joint>right_rear_joint</right_joint>
        <wheel_separation>1.1</wheel_separation>
        <wheel_radius>0.35</wheel_radius>
        <topic>/cmd_vel</topic>
      </plugin>

      <plugin filename="gz-sim-triggered-publisher-system" name="gz::sim::systems::TriggeredPublisher">
        <input type="gz.msgs.Joy" topic="/joy"/>
        <output type="gz.msgs.Twist" topic="/cmd_vel"/>
        <match field="buttons" value="5">
          <match field="axes" value="1" keyword="linear.x" scale="0.5"/>
          <match field="axes" value="2" keyword="angular.z" scale="0.5"/>
        </match>
      </plugin>

      <link name="lidar_link">
        <pose>-1.0530 -0.06 0.8053 0 0 0</pose> 
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material> </visual>
        
        <sensor name="gpu_lidar" type="gpu_lidar">
          <pose>0 0 0 0 0 0</pose>
          <update_rate>10</update_rate> <topic>/scan</topic> 
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-4.7124</min_angle> 
                <max_angle>4.7124</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.08</min>
              <max>12.0</max> <resolution>0.01</resolution>
            </range>
          </lidar>
          <always_on>1</always_on>
          <visualize>true</visualize> </sensor>
      </link>

      <joint name="lidar_joint" type="fixed">
        <parent>chassis</parent>
        <child>lidar_link</child>
      </joint>

      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </model>

  </world>
</sdf>