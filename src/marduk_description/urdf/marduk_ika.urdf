<?xml version="1.0" ?>
<robot name="marduk_ika">

  <link name="">
    <inertial>
      <mass value="0.001"/> 
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="-0.5107 1.3734 0.7" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://marduk_description/meshes/sasi.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.5107 1.3734 0.7" rpy="0 0 0"/>
      <geometry>
        <box size="1.6 0.4 0.5"/>
      </geometry>
    </collision>
  </link>

  <link name="left_front_wheel">
    <inertial>
      <mass value="25.0"/>
      <inertia ixx="1.5" ixy="0.0" ixz="0.0" iyy="1.5" iyz="0.0" izz="2.5"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.35" length="0.15"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.35" length="0.15"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_frmarduk_ika/chassisont_joint" type="continuous">
    <parent link=""/>
    <child link="left_front_wheel"/>
    <origin xyz="-1.15 0.55 0.35" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_rear_wheel">
    <inertial>
      <mass value="25.0"/>
      <inertia ixx="1.5" ixy="0.0" ixz="0.0" iyy="1.5" iyz="0.0" izz="2.5"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.35" length="0.15"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.35" length="0.15"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_rear_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin xyz="0.45 0.55 0.35" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_front_wheel">
    <inertial>
      <mass value="25.0"/>
      <inertia ixx="1.5" ixy="0.0" ixz="0.0" iyy="1.5" iyz="0.0" izz="2.5"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.35" length="0.15"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.35" length="0.15"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_front_joint" type="continuous">
    <parent link="marduk_ika/chassis"/>
    <child link="right_front_wheel"/>
    <origin xyz="-1.15 -0.64 0.35" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_rear_wheel">
    <inertial>
      <mass value="25.0"/>
      <inertia ixx="1.5" ixy="0.0" ixz="0.0" iyy="1.5" iyz="0.0" izz="2.5"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.35" length="0.15"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.35" length="0.15"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_rear_joint" type="continuous">
    <parent link="marduk_ika/chassis"/>
    <child link="right_rear_wheel"/>
    <origin xyz="0.45 -0.64 0.35" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="marduk_ika/lidar_link/gpu_lidar">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="marduk_ika/chassis"/>
    <child link="marduk_ika/lidar_link/gpu_lidar"/>
    <origin xyz="-1.0530 -0.06 0.8053" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_joint</left_joint>
      <left_joint>left_rear_joint</left_joint>
      <right_joint>right_front_joint</right_joint>
      <right_joint>right_rear_joint</right_joint>
      <wheel_separation>1.1</wheel_separation>
      <wheel_radius>0.35</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>marduk_ika/chassis</child_frame_id>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
  </gazebo>

</robot>